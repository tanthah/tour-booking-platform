# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/tour_booking_db

# JWT
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d

# Email (SMTP) - Sử dụng Gmail App Password
# Hướng dẫn tạo App Password: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_gmail_app_password_16_chars
MAIL_FROM=Tour Booking <your_gmail@gmail.com>

# Cloudinary - Dich vu luu tru va quan ly anh
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Tai khoan Admin mac dinh - Dung cho script createAdmin.js (node createAdmin.js)
ADMIN_EMAIL=admin@tourbooking.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULLNAME=Quan Tri Vien
ADMIN_PHONE=0900000001
